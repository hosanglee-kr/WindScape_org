{
    # 기본 스타일 가이드: Google 스타일 기반
    BasedOnStyle: Google,

    # 탭 사용 여부: Never (공백 사용)
    UseTab: Never,

    # 들여쓰기 너비: 4칸
    IndentWidth: 4,

    # 탭 너비: 4칸
    TabWidth: 4,

    # 한 줄의 최대 길이 제한: 0 (제한 없음, 줄바꿈 강제 방지)
    ColumnLimit: 0,

    # 대입 연산자(=) 주변 줄바꿈 페널티: 고득점일수록 줄바꿈을 기피함
    PenaltyBreakAssignment: 1000,

    # 함수 호출 시 첫 번째 파라미터 이전 줄바꿈 페널티: 극대화하여 한 행 유지
    PenaltyBreakBeforeFirstCallParameter: 1000,

    # 함수/코드 블록/조건문 등을 한 줄로 허용하는 설정
    AllowShortFunctionsOnASingleLine: All,    # 모든 짧은 함수를 한 줄로 표시
    AllowShortBlocksOnASingleLine: Always,   # 모든 코드 블록을 한 줄로 표시
    AllowShortIfStatementsOnASingleLine: true, # 짧은 if 문을 한 줄로 표시
    AllowShortLoopsOnASingleLine: true,      # 짧은 반복문을 한 줄로 표시

    # 인자들(Arguments/Parameters)을 한 줄에 최대한 모아서 배치 (BinPacking)
    BinPackArguments: true,
    BinPackParameters: true,

    # 여는 괄호 '(' 다음의 정렬 방식: DontAlign (한 줄 유지를 위해 정렬 비활성화)
    AlignAfterOpenBracket: DontAlign,

    # [수정/핵심] 연속된 대입문의 '=' 기호를 세로로 정렬
    # AcrossEmptyLinesAndComments: 중간에 빈 줄이나 주석이 있어도 정렬 유지
    AlignConsecutiveAssignments: AcrossEmptyLinesAndComments,

    # 빈 줄이나 주석이 있어도 연속된 선언문을 정렬함
    AlignConsecutiveDeclarations: AcrossEmptyLinesAndComments,

    # 빈 줄이나 주석이 있어도 연속된 매크로(#define)를 정렬함
    AlignConsecutiveMacros: AcrossEmptyLinesAndComments,

    # 전처리기(#if, #define 등) 들여쓰기: BeforeHash (해시 기호 앞에서 들여쓰기)
    IndentPPDirectives: BeforeHash,

    # 열거형(Enum)을 한 줄로 표시할지 여부: false (사용자님의 이전 설정 반영)
    AllowShortEnumsOnASingleLine: false,
}

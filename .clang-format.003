{
    BasedOnStyle: Google,
    UseTab: Never,
    IndentWidth: 4,
    TabWidth: 4,

    # [수정] 0 대신 매우 큰 값을 주어 포맷터가 한 줄에 다 들어간다고 판단하게 함
    ColumnLimit: 10000,

    # [핵심 수정] #if, #endif 등을 코드 들여쓰기에 맞춰 정렬
    # BeforeHash: # 기호는 0열에 고정하고 뒤의 명령만 들여씀
    # AfterHash: # 기호 자체를 코드 들여쓰기만큼 밀어 넣음
    IndentPPDirectives: AfterHash,

    # [추가] 연속된 빈 줄이나 줄바꿈 유지 설정 최소화
    MaxEmptyLinesToKeep: 1,
    KeepEmptyLinesAtTheStartOfBlocks: false,

    # [핵심] 대입문 세로 정렬
    AlignConsecutiveAssignments: AcrossEmptyLinesAndComments,

    # [강화] 줄바꿈 방지 페널티 극대화
    PenaltyBreakAssignment: 10000,
    PenaltyBreakBeforeFirstCallParameter: 10000,

    # [강화] 괄호 및 대입 관련 한 줄 유지 설정
    AllowShortFunctionsOnASingleLine: All,
    AllowShortBlocksOnASingleLine: Always,
    AllowShortIfStatementsOnASingleLine: true,
    AllowShortLoopsOnASingleLine: true,

    # 인자들을 한 줄에 채우기
    BinPackArguments: true,
    BinPackParameters: true,

    # 정렬 및 전처리기 설정
    AlignAfterOpenBracket: DontAlign,
    AlignConsecutiveDeclarations: AcrossEmptyLinesAndComments,
    AlignConsecutiveMacros: AcrossEmptyLinesAndComments,
    AllowShortEnumsOnASingleLine: false,
}
